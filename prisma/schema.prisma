generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @default(now())
  duration  String
  status    String   // "upcoming", "recorded"
  mediaUrl  String?
  attendees Attendee[]
  
  transcripts TranscriptLine[]
  summaries   Summary[]
  actionItems ActionItem[]
}

model Attendee {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model TranscriptLine {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker   String
  text      String
  startTime Float
  endTime   Float
  createdAt DateTime @default(now())
}

model Summary {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  template        String   // "Standard", "Executive", "ActionItems"
  contentMarkdown String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([meetingId, template])
}

model ActionItem {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task        String
  assignee    String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
